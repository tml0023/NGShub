// ngs-web Illumina short-read pipeline: FASTQ -> QC -> trim -> align -> markdup -> VCF

params {
    // I/O
    input           = null
    fasta           = null
    outdir          = 'results'

    // tool selection
    trimmer         = 'fastp'          // fastp | trimgalore | none
    aligner         = 'bwamem2'        // bwamem2 | bwa | bowtie2
    markduplicates  = 'gatk'           // gatk | samtools | none
    callers         = 'haplotypecaller' // comma list: haplotypecaller,bcftools,freebayes
    skip_fastqc     = false

    // per-tool extra arguments
    fastp_args            = ''
    trimgalore_args       = ''
    haplotypecaller_args  = ''
    bcftools_args         = ''
    freebayes_args        = ''

    // caches shared across runs
    reference_cache = "${System.getProperty('user.home')}/.ngs-web/reference_cache"
    conda_cache_dir = "${System.getProperty('user.home')}/.ngs-web/conda"

    // resource ceiling for this machine
    max_cpus        = 6
    max_memory      = '6.GB'
    max_time        = '48.h'
}

includeConfig 'conf/base.config'

conda {
    enabled  = true
    cacheDir = params.conda_cache_dir
    channels = ['conda-forge', 'bioconda']
}

profiles {
    standard {
        // local execution with conda-provisioned tools (default)
        process.executor = 'local'
    }

    micromamba {
        // much faster env solving than classic conda
        conda.useMicromamba = true
        process.executor    = 'local'
    }

    slurm {
        process.executor      = 'slurm'
        process.queue         = System.getenv('NGSWEB_SLURM_QUEUE') ?: 'normal'
        executor.queueSize    = 50
        conda.useMicromamba   = true
    }

    test {
        params.max_cpus   = 2
        params.max_memory = '3.GB'
    }
}

// ---- run provenance ------------------------------------------------------
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    // `process` and `tag` are not in the default field set, and the UI
    // progress table is built from this file.
    fields    = 'task_id,process,tag,name,status,exit,duration,realtime,peak_rss'
}

manifest {
    name            = 'ngs-web/illumina'
    description     = 'Illumina short-read germline variant calling with selectable tools'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}
