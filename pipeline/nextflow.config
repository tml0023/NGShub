// ngs-web pipelines: FASTQ -> QC -> [trim/filter] -> align -> [markdup] -> VCF
// (or, for the rna/ workflows, -> quantification [-> differential expression])
// Shared across all six platform workflows (main.nf, pacbio/main.nf,
// ont/main.nf, rna/illumina/main.nf, rna/pacbio/main.nf, rna/ont/main.nf) --
// profiles, resource limits, and conda/docker config here apply to whichever
// one is actually run.

params {
    // I/O
    input           = null
    fasta           = null
    gtf             = null              // RNA-seq platforms: gene annotation matched to --fasta
    outdir          = 'results'

    // tool selection
    trimmer         = 'fastp'          // fastp | trimgalore | none
    aligner         = 'bwamem2'        // bwamem2 | bwa | bowtie2
    markduplicates  = 'gatk'           // gatk | samtools | none
    bqsr            = false            // base quality score recalibration (needs known_sites)
    known_sites     = ''                // comma-separated known-variant VCF paths (each needs a .tbi alongside)
    callers         = 'haplotypecaller' // comma list: haplotypecaller,bcftools,freebayes
    sv_callers      = ''                // comma list, opt-in: manta,delly (illumina) | pbsv,sniffles2 (pacbio) | sniffles2,cutesv (ont)
    skip_fastqc     = false

    // per-tool extra arguments
    fastp_args            = ''
    trimgalore_args       = ''
    haplotypecaller_args  = ''
    bcftools_args         = ''
    freebayes_args        = ''
    deepvariant_args      = ''
    // Overrides DeepVariant's --num_shards (default: task.cpus). Lower this on
    // memory-constrained hosts -- each shard runs its own make_examples worker,
    // and peak memory scales with shard count more than with input size.
    deepvariant_num_shards = null
    clair3_model          = 'hifi_revio'
    clair3_args           = ''
    ont_clair3_model      = 'r1041_e82_400bps_sup_v520'
    chopper_min_quality   = 10
    chopper_min_length    = 500

    // RNA-seq (rna/illumina)
    // STAR's own default (14) assumes a large genome; small/test references
    // need this lowered (min(14, log2(genomeLength/nContigs) - 1)) or
    // genomeGenerate crashes with a suggested-index-size error.
    star_sa_index_nbases = 14
    salmon_kmer_len       = 31
    // RNA-seq (rna/pacbio) -- null means "use the bundled standard NEB Iso-Seq
    // primers" (resolved in rna/pacbio/main.nf); override for a different kit
    // (e.g. Kinnex barcoded primers).
    primers               = null

    // caches shared across runs
    reference_cache = "${System.getProperty('user.home')}/.ngs-web/reference_cache"
    conda_cache_dir = "${System.getProperty('user.home')}/.ngs-web/conda"

    // resource ceiling for this machine
    max_cpus        = 6
    max_memory      = '6.GB'
    max_time        = '48.h'
}

includeConfig 'conf/base.config'

conda {
    enabled  = true
    cacheDir = params.conda_cache_dir
    channels = ['conda-forge', 'bioconda']
}

profiles {
    standard {
        // local execution with conda-provisioned tools (default)
        process.executor = 'local'
    }

    micromamba {
        // much faster env solving than classic conda
        conda.useMicromamba = true
        process.executor    = 'local'
    }

    docker {
        // Processes with a `container` directive (DragMap, DeepVariant) run
        // via Docker; every other process still resolves its own conda env,
        // since only those two need a container to work at all. Nextflow
        // doesn't automatically prefer container over conda when both are
        // enabled, so conda is explicitly cleared for just these processes
        // to force the fallback to their container.
        docker.enabled       = true
        conda.useMicromamba  = true
        process.executor     = 'local'
        process {
            withName: 'DRAGMAP_HASHTABLE|DRAGMAP_ALIGN|PBMARKDUP|DEEPVARIANT|MANTA|PBSV_CALL|LIMA|ISOSEQ_REFINE|ISOSEQ_CLUSTER2|ISOSEQ_COLLAPSE|PIGEON_PREPARE_REFERENCE|PIGEON_CLASSIFY|PIGEON_FILTER' {
                conda = null
            }
        }
    }

    slurm {
        process.executor      = 'slurm'
        process.queue         = System.getenv('NGSWEB_SLURM_QUEUE') ?: 'normal'
        executor.queueSize    = 50
        conda.useMicromamba   = true
    }

    test {
        params.max_cpus   = 2
        params.max_memory = '3.GB'
    }
}

// ---- run provenance ------------------------------------------------------
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    // `process` and `tag` are not in the default field set, and the UI
    // progress table is built from this file.
    fields    = 'task_id,process,tag,name,status,exit,duration,realtime,peak_rss'
}

manifest {
    name            = 'ngs-web/illumina'
    description     = 'Illumina short-read germline variant calling with selectable tools'
    version         = '0.1.0'
    nextflowVersion = '>=24.04.0'
}
